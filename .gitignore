# 本地密钥配置（勿提交真实密钥）
.env

# Python 编译产物（曾把 6 个 .pyc 混进版本库）
__pycache__/
*.py[cod]
*.pyc

# 运行日志：workflow 每轮生成，提交会让仓库无意义膨胀
*_run.log
fetch_run.log
tg_run.log

# 诊断输出：移动管线每轮重写，仅供排查用
_diag.json

# 公告抓取诊断日志：由 workflow 生成，仅供排查用，不入库
probe/

# 联通累积池（约 68MB）：跨轮状态改由 Actions 缓存保存，
# 每轮入库会让仓库每天膨胀，这里排除
unicom/data/_pool.json
unicom/_pool.json.gz
